{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "TOML",
  "scopeName": "source.toml",
  "patterns": [
    { "include": "#comments" },
    { "include": "#table-headers" },
    { "include": "#keys" },
    { "include": "#inline-tables" },
    { "include": "#strings" },
    { "include": "#date-times" },
    { "include": "#numbers" },
    { "include": "#booleans" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.toml",
          "match": "#.*$"
        }
      ]
    },
    "table-headers": {
      "patterns": [
        {
          "name": "meta.table.array.toml",
          "match": "^(\\s*)(\\[\\[)\\s*((?:[A-Za-z0-9_-]+|\"(?:\\\\.|[^\"\\\\])*\"|'[^']*')(?:\\s*\\.\\s*(?:[A-Za-z0-9_-]+|\"(?:\\\\.|[^\"\\\\])*\"|'[^']*'))*)\\s*(\\]\\])",
          "captures": {
            "2": { "name": "punctuation.definition.table.begin.toml" },
            "3": {
              "name": "entity.name.section.array.toml entity.name.namespace.toml"
            },
            "4": { "name": "punctuation.definition.table.end.toml" }
          }
        },
        {
          "name": "meta.table.toml",
          "match": "^(\\s*)(\\[)\\s*((?:[A-Za-z0-9_-]+|\"(?:\\\\.|[^\"\\\\])*\"|'[^']*')(?:\\s*\\.\\s*(?:[A-Za-z0-9_-]+|\"(?:\\\\.|[^\"\\\\])*\"|'[^']*'))*)\\s*(\\])",
          "captures": {
            "2": { "name": "punctuation.definition.table.begin.toml" },
            "3": {
              "name": "entity.name.section.toml entity.name.namespace.toml"
            },
            "4": { "name": "punctuation.definition.table.end.toml" }
          }
        }
      ]
    },
    "keys": {
      "patterns": [
        {
          "match": "(?x)(?:^|(?<=[{,]))\\s*((?:[A-Za-z0-9_-]+|\"(?:\\\\.|[^\"\\\\])*\"|'[^']*')(?:\\s*\\.\\s*(?:[A-Za-z0-9_-]+|\"(?:\\\\.|[^\"\\\\])*\"|'[^']*'))*)\\s*(=)(?=\\s*\\[)",
          "captures": {
            "1": {
              "name": "variable.other.property.array.toml"
            },
            "2": { "name": "keyword.operator.assignment.toml" }
          }
        },
        {
          "match": "(?x)(?:^|(?<=[{,]))\\s*((?:[A-Za-z0-9_-]+|\"(?:\\\\.|[^\"\\\\])*\"|'[^']*')(?:\\s*\\.\\s*(?:[A-Za-z0-9_-]+|\"(?:\\\\.|[^\"\\\\])*\"|'[^']*'))*)\\s*(=)(?=\\s*\\{)",
          "captures": {
            "1": {
              "name": "variable.other.property.table.toml"
            },
            "2": { "name": "keyword.operator.assignment.toml" }
          }
        },
        {
          "match": "(?x)(?:^|(?<=[{,]))\\s*((?:[A-Za-z0-9_-]+|\"(?:\\\\.|[^\"\\\\])*\"|'[^']*')(?:\\s*\\.\\s*(?:[A-Za-z0-9_-]+|\"(?:\\\\.|[^\"\\\\])*\"|'[^']*'))*)\\s*(=)",
          "captures": {
            "1": {
              "name": "variable.other.property.toml"
            },
            "2": { "name": "keyword.operator.assignment.toml" }
          }
        }
      ]
    },
    "inline-tables": {
      "name": "meta.inline-table.toml",
      "begin": "\\{",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.collection.begin.toml" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.definition.collection.end.toml" }
      },
      "patterns": [
        { "include": "#comments" },
        { "include": "#inline-table-keys" },
        { "include": "#inline-tables" },
        { "include": "#strings" },
        { "include": "#date-times" },
        { "include": "#numbers" },
        { "include": "#booleans" },
        { "include": "#punctuation" }
      ]
    },
    "inline-table-keys": {
      "patterns": [
        {
          "match": "(?x)(?:^|(?<=[{,]))\\s*((?:[A-Za-z0-9_-]+|\"(?:\\\\.|[^\"\\\\])*\"|'[^']*')(?:\\s*\\.\\s*(?:[A-Za-z0-9_-]+|\"(?:\\\\.|[^\"\\\\])*\"|'[^']*'))*)\\s*(=)(?=\\s*\\[)",
          "captures": {
            "1": {
              "name": "variable.other.property.array.toml variable.other.property.inline-table-member.toml"
            },
            "2": { "name": "keyword.operator.assignment.toml" }
          }
        },
        {
          "match": "(?x)(?:^|(?<=[{,]))\\s*((?:[A-Za-z0-9_-]+|\"(?:\\\\.|[^\"\\\\])*\"|'[^']*')(?:\\s*\\.\\s*(?:[A-Za-z0-9_-]+|\"(?:\\\\.|[^\"\\\\])*\"|'[^']*'))*)\\s*(=)(?=\\s*\\{)",
          "captures": {
            "1": {
              "name": "variable.other.property.table.toml variable.other.property.inline-table-member.toml"
            },
            "2": { "name": "keyword.operator.assignment.toml" }
          }
        },
        {
          "match": "(?x)(?:^|(?<=[{,]))\\s*((?:[A-Za-z0-9_-]+|\"(?:\\\\.|[^\"\\\\])*\"|'[^']*')(?:\\s*\\.\\s*(?:[A-Za-z0-9_-]+|\"(?:\\\\.|[^\"\\\\])*\"|'[^']*'))*)\\s*(=)",
          "captures": {
            "1": {
              "name": "variable.other.property.inline-table-member.toml"
            },
            "2": { "name": "keyword.operator.assignment.toml" }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.block.toml",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            {
              "name": "constant.character.escape.toml",
              "match": "\\\\(?:[btnfr\"\\\\]|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|x[0-9A-Fa-f]{2}|e)"
            }
          ]
        },
        {
          "name": "string.quoted.single.block.toml",
          "begin": "'''",
          "end": "'''"
        },
        {
          "name": "string.quoted.double.toml",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.toml",
              "match": "\\\\(?:[btnfr\"\\\\]|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|x[0-9A-Fa-f]{2}|e)"
            }
          ]
        },
        {
          "name": "string.quoted.single.toml",
          "begin": "'",
          "end": "'"
        }
      ]
    },
    "date-times": {
      "patterns": [
        {
          "name": "constant.other.datetime.toml",
          "match": "(?<![A-Za-z0-9_-])\\d{4}-\\d{2}-\\d{2}(?:[Tt ]\\d{2}:\\d{2}(?::\\d{2}(?:\\.\\d+)?)?(?:[Zz]|[+-]\\d{2}:\\d{2})?)?(?![A-Za-z0-9_-])"
        },
        {
          "name": "constant.other.datetime.toml",
          "match": "(?<![A-Za-z0-9_-])\\d{2}:\\d{2}(?::\\d{2}(?:\\.\\d+)?)?(?![A-Za-z0-9_-])"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.toml",
          "match": "(?<![A-Za-z0-9_-])[+-]?(?:inf|nan|(?:\\d(?:_?\\d)*)?(?:\\.\\d(?:_?\\d)*)(?:[eE][+-]?\\d(?:_?\\d)*)?|\\d(?:_?\\d)*[eE][+-]?\\d(?:_?\\d)*)(?![A-Za-z0-9_-])"
        },
        {
          "name": "constant.numeric.integer.toml",
          "match": "(?<![A-Za-z0-9_-])(?:(?<![+-])0(?:x[0-9A-Fa-f](?:_?[0-9A-Fa-f])*|o[0-7](?:_?[0-7])*|b[01](?:_?[01])*)|[+-]?\\d(?:_?\\d)*)(?![A-Za-z0-9_-])"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.toml",
          "match": "(?<![A-Za-z0-9_-])(?:true|false)(?![A-Za-z0-9_-])"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.toml",
          "match": "[,\\.]"
        },
        {
          "name": "punctuation.definition.collection.toml",
          "match": "[\\[\\]{}]"
        }
      ]
    }
  }
}
